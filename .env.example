# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Credentials:
# Obtain these from your Supabase Project Settings -> API.
# VITE_SUPABASE_URL: Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Client-safe publishable key
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_SERVICE_ROLE_KEY: Privileged server-side key for administrative user management (kept strictly server-side)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Server Session Signing Secret (auto-generated in memory if omitted)
SESSION_SECRET=

# Optional initial administrator password (if unset, claim via first-run admin setup in /login?tab=admin)
ADMIN_INITIAL_PASSWORD=
